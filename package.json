{
  "name": "mcp-auth-gateway",
  "version": "1.0.0",
  "description": "OAuth-secured MCP gateway for Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --config wrangler.paperless.toml",
    "deploy": "wrangler deploy --config wrangler.paperless.toml",
    "tail": "wrangler tail --config wrangler.paperless.toml",
    "rollback": "wrangler rollback --config wrangler.paperless.toml",
    "deploy:paperless": "wrangler deploy --config wrangler.paperless.toml",
    "deploy:things": "wrangler deploy --config wrangler.things.toml",
    "tail:paperless": "wrangler tail --config wrangler.paperless.toml",
    "tail:things": "wrangler tail --config wrangler.things.toml",
    "secrets:paperless": "echo 'Use: wrangler secret put <NAME> --config wrangler.paperless.toml'",
    "secrets:things": "echo 'Use: wrangler secret put <NAME> --config wrangler.things.toml'"
  },
  "keywords": [
    "mcp",
    "oauth",
    "cloudflare",
    "workers"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251229.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.2.2"
  }
}
